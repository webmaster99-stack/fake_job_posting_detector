# `dvc plots show` output
dvc_plots/

# Data & model artifacts are tracked by DVC, not git.
# Don't ignore data/raw here: DVC skips git-ignored .dvc files, so raw data added with
# `dvc add` would silently never be pushed or pulled. DVC writes data/raw/.gitignore.
/data/interim/*
/data/processed/*
/models/*
!**/.gitkeep
# Outputs downloaded from the Colab notebook (04_transformer_colab), before `dvc commit`.
transformer_outputs.zip

