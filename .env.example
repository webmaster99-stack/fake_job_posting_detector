# Copy to .env and fill in. Never commit .env.

# DagsHub (MLflow tracking + registry, DVC remote).
# REQUIRED for everyone, including to reproduce the project: DagsHub only serves DVC data
# to signed-in users, even for public repos. A free account works: create a token at
# https://dagshub.com/user/settings/tokens, then run `uv run poe dvc-auth`.
# Your own account gets read access; push/write access is maintainer-only.
DAGSHUB_USER=
DAGSHUB_TOKEN=

# Everything below is maintainer / CI only.

# MLflow on DagsHub (needs write access). Leave commented out to log runs to a local store
# instead (mlflow.db + mlartifacts/ in the project root; browse with `uv run mlflow ui
# --backend-store-uri sqlite:///mlflow.db`). If set without write access, `dvc repro` fails
# at the `evaluate` stage.
# MLFLOW_TRACKING_URI=https://dagshub.com/webmaster99-stack/fake_job_posting_detector.mlflow
# MLFLOW_TRACKING_USERNAME=${DAGSHUB_USER}
# MLFLOW_TRACKING_PASSWORD=${DAGSHUB_TOKEN}

# Kaggle (one-time raw data download by maintainer)
KAGGLE_USERNAME=
KAGGLE_KEY=

# Backend (`uv run poe api` locally; Render in production, see render.yaml).
# Loads models:/fake-job-detector@champion from the MLflow server above (or from the local
# mlflow.db without MLFLOW_TRACKING_URI). MODEL_URI overrides it, e.g. with a local model path.
# Without DATABASE_URL, predictions go to backend/local.db (create it with `uv run poe migrate`).
# DATABASE_URL=postgresql://<user>:<password>@<host>.neon.tech/<db>?sslmode=require
# MODEL_URI=
ALLOWED_ORIGINS=http://localhost:3000
# RATE_LIMIT_PER_MINUTE=30
