# Copy to .env and fill in. Never commit .env.

# DagsHub (MLflow tracking + registry, DVC remote).
# REQUIRED for everyone, including to reproduce the project: DagsHub only serves DVC data
# to signed-in users, even for public repos. A free account works: create a token at
# https://dagshub.com/user/settings/tokens, then run `uv run poe dvc-auth`.
# Your own account gets read access; push/write access is maintainer-only.
DAGSHUB_USER=
DAGSHUB_TOKEN=

# Everything below is maintainer / CI only.
MLFLOW_TRACKING_URI=https://dagshub.com/webmaster99-stack/fake_job_posting_detector.mlflow
MLFLOW_TRACKING_USERNAME=${DAGSHUB_USER}
MLFLOW_TRACKING_PASSWORD=${DAGSHUB_TOKEN}

# Kaggle (one-time raw data download by maintainer)
KAGGLE_USERNAME=
KAGGLE_KEY=

# Backend (Render)
DATABASE_URL=
ALLOWED_ORIGINS=http://localhost:3000
