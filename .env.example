# Copy to .env and fill in. Never commit .env.
# Only needed by the maintainer / CI for WRITE access. Reproducing the project
# from a fresh clone needs none of these (DagsHub repo is public).

# DagsHub (MLflow tracking + registry, DVC remote)
DAGSHUB_USER=
DAGSHUB_TOKEN=
MLFLOW_TRACKING_URI=https://dagshub.com/<user>/fake_job_posting_detector.mlflow
MLFLOW_TRACKING_USERNAME=${DAGSHUB_USER}
MLFLOW_TRACKING_PASSWORD=${DAGSHUB_TOKEN}

# Kaggle (one-time raw data download by maintainer)
KAGGLE_USERNAME=
KAGGLE_KEY=

# Backend (Render)
DATABASE_URL=
ALLOWED_ORIGINS=http://localhost:3000
